        %1113 = wave.assume %1002 as "x" [#wave.pred<"x >= 0">, #wave.pred<"-1073741816 + x <= 0">] : !wave.simd<i32, 64>
        %1114 = wave.ptr_add %1067, %1113 : !wave.ptr<#waveamd.buffer, f16>, !wave.simd<i32, 64> -> !wave.simd<!wave.ptr<#waveamd.buffer, f16>, 64>
        %1115 = wave.select %1111, %1114, %1072 : !wave.mask<64>, !wave.simd<!wave.ptr<#waveamd.buffer, f16>, 64>
        %1116 = wave.store %1112 -> %1115 : (!wave.simd<vector<8xf16>, 64>, !wave.simd<!wave.ptr<#waveamd.buffer, f16>, 64>) -> !wave.mem.token
        scf.yield %776, %776, %883 : !wave.mem.token, !wave.mem.token, !wave.mem.token
      }
      return
    }
  }
}
