        %1118 = wave.select %1114, %1117, %1075 : !wave.mask<64>, !wave.simd<!wave.ptr<#waveamd.buffer, f16>, 64>
        %1119 = wave.store %1115 -> %1118 {cache = #waveamd.store_cache<cs>} : (!wave.simd<vector<8xf16>, 64>, !wave.simd<!wave.ptr<#waveamd.buffer, f16>, 64>) -> !wave.mem.token
        scf.yield %822 : !wave.mem.token
      }
      return
    }
  }
}
