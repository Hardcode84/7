#ifndef W
#error missing W
#endif

#ifndef PP_FORCED_OFFSET
#error missing forced include
#endif

kernel [[amdgpu_wave_size(W)]]
void pp_forced(uint32_t *out) {
  token output_done = token();
  simd<uint32_t, W> lane = lane_id<W>();
  simd<uint32_t, W> value = lane + PP_FORCED_OFFSET;
  output_done = join(output_done, store(value, out + lane));
  observe(output_done);
}
