kernel [[amdgpu_wave_size(32)]]
void ptr_cast(float *base) {
  token output_done = token();
  vector<float, 4> *vec = cast<vector<float, 4> *>(base);
  simd<uint32_t, 32> lane = lane_id<32>();
  simd<vector<float, 4>, 32> value = load(vec + lane);
  output_done = join(output_done, store(value, vec + lane));
  observe(output_done);
}
