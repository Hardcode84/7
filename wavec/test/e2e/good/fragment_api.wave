#define ACC_T fragment<2, float, 16, 16, 32, 8>
#define FRAGMENT_LOAD(NAME, TY, PTR, DEP) \
  auto [NAME##_regs, NAME##_tok] = load(PTR after DEP); \
  TY NAME = fragment_pack<TY>(NAME##_regs);
#define FRAGMENT_STORE(TOK, FRAG, PTR, DEP) \
  simd<vector<int32_t, 8>, 32> TOK##_regs = fragment_unpack(FRAG); \
  token TOK = store(TOK##_regs, PTR after DEP);

kernel [[amdgpu_wave_size(32)]] void fragment_api(vector<int32_t, 8> *scratch) {
  fragment<0, half, 16, 16, 32, 8> a =
      fragment_fill<fragment<0, half, 16, 16, 32, 8>>(0);
  fragment<1, half, 16, 16, 32, 8> b =
      fragment_fill<fragment<1, half, 16, 16, 32, 8>>(0);
  ACC_T acc = fragment_fill<ACC_T>(0);
  simd<vector<int32_t, 8>, 32> regs = fragment_unpack(acc);
  ACC_T acc2 = fragment_pack<ACC_T>(regs);
  acc2 = mma_wmma_f32_16x16x16_f16(a, b, acc2);
  uint32_t first = read_first(lane_id<32>());
  index sid = subgroup_id();
  simd<uint32_t, 32> lane = lane_id<32>();
  token seed = token();
  FRAGMENT_LOAD(from_mem, ACC_T, scratch + lane, seed)
  FRAGMENT_STORE(done, from_mem, scratch + lane, from_mem_tok)
}
