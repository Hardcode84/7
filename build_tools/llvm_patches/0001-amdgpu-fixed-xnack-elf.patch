+// RUN: llvm-mc --triple=amdgcn-amd-amdhsa --mcpu=gfx12-5-generic --amdhsa-code-object-version=6 --filetype=obj %t/default.s -o - | llvm-readobj --file-headers - | FileCheck %s --check-prefix=GENERIC
+
+// Fixed hardware XNACK does not add a selectable target-ID mode.
+// GFX1250: Flags [ (0x449)
+// GFX1251: Flags [ (0x45A)
+// STRICT: Flags [ (0x4EB)
+// GENERIC: Flags [ (0x100045B)
+// ANY: Flags [ (0x54F)
