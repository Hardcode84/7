--- a/llvm/lib/Target/AMDGPU/MCTargetDesc/AMDGPUTargetStreamer.cpp
+++ b/llvm/lib/Target/AMDGPU/MCTargetDesc/AMDGPUTargetStreamer.cpp
@@ -932,8 +932,12 @@
   // mach.
   EFlagsV4 |= getElfMach(STI.getCPU());

-  // xnack.
-  switch (getTargetID()->getXnackSetting()) {
+  // ELF target-ID modes exclude XNACK that is fixed by the processor.
+  AMDGPU::TargetIDSetting XnackSetting = getTargetID()->getXnackSetting();
+  if (!AMDGPU::getFeatureBitset(AMDGPU::parseArchAMDGCN(STI.getCPU()))
+           .test(AMDGPU::FEAT_XNACK_ON_OFF_MODES))
+    XnackSetting = AMDGPU::TargetIDSetting::Unsupported;
+  switch (XnackSetting) {
   case AMDGPU::TargetIDSetting::Unsupported:
     EFlagsV4 |= ELF::EF_AMDGPU_FEATURE_XNACK_UNSUPPORTED_V4;
     break;
