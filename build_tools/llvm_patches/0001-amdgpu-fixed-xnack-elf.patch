+// RUN: llvm-mc --triple=amdgcn-amd-amdhsa --mcpu=gfx1250 --amdhsa-code-object-version=6 --filetype=obj %t/default.s -o - | llvm-readobj --file-headers - | FileCheck %s --check-prefix=GFX1250
+// RUN: llvm-mc --triple=amdgcn-amd-amdhsa --mcpu=gfx1251 --amdhsa-code-object-version=6 --filetype=obj %t/default.s -o - | llvm-readobj --file-headers - | FileCheck %s --check-prefix=GFX1251
+// RUN: llvm-mc --triple=amdgcn-amd-amdhsa --mcpu=gfx1250-strict --amdhsa-code-object-version=6 --filetype=obj %t/default.s -o - | llvm-readobj --file-headers - | FileCheck %s --check-prefix=STRICT
