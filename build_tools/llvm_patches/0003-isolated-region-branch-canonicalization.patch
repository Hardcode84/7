+
+// CANON-LABEL: func.func @isolated_dead_input
+// CANON-SAME: %[[X:.*]]: i32
+// CANON: "test.isolated_region_branch"(%[[X]])
+// CANON: ^bb0(%[[ARG:.*]]: i32):
+// CANON-NEXT: "test.isolated_region_yield"(%[[ARG]])
+func.func @isolated_dead_input(%x: i32) -> i32 {
+  %r = "test.isolated_region_branch"(%x, %x) ({
+  ^bb0(%arg: i32, %dead: i32):
+    "test.isolated_region_yield"(%arg) : (i32) -> ()
+  }) : (i32, i32) -> i32
+  return %r : i32
+}
